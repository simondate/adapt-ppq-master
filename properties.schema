{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "globals": {
    "ariaRegion": {
      "type": "string",
      "required": true,
      "default": "A question component that requires users to correctly position one or more pins on an image.",
      "inputType": "Text",
      "validators": [],
      "translatable": true
    }
  },
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "full-width",
      "editorOnly": true
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "help": "This is the instruction text",
      "translatable": true
    },
    "_shouldDisplayAttempts": {
      "type": "boolean",
      "required": false,
      "default": false,
      "validators": []
    },
    "_attempts": {
      "type": "number",
      "required": true,
      "default": 1,
      "validators": ["number"]
    },
    "_minSelection": {
      "type": "number",
      "required": false,
      "default": 1,
      "validators": ["number"]
    },
    "_canShowModelAnswer": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Allow showing correct answer.",
      "inputType": {
        "type": "Boolean",
        "options": [
          true,
          false
        ]
      },
      "validators": [],
      "help": "Select 'true' to allow student to reveal correct answer on button press."
    },
    "_developerMode": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Developer mode",
      "inputType": {
        "type": "Boolean",
        "options": [
          true,
          false
        ]
      },
      "validators": [],
      "help": "Select 'true' to show correct zones in preview"
    },
    "_shouldShowZones": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Show Zones to user after feedback.",
      "inputType": {
        "type": "Boolean",
        "options": [
          true,
          false
        ]
      },
      "validators": [],
      "help": "Select 'true' to show correct zones to user after feedback"
    },
    "_shouldDisplayAttempts": {
      "type": "boolean",
      "required": false,
      "default": false,
      "validators": []
    },
    "_attempts": {
      "type": "number",
      "required": true,
      "default": 1,
      "va lidators": ["number"]
    },
    "_selectable": {
      "type": "number",
      "required": false,
      "default": 1,
      "validators": ["number"]
    },
    "_canShowModelAnswer": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Allow showing correct answer.",
      "inputType": {
        "type": "Boolean",
        "options": [
          true,
          false
        ]
      },
      "validators": [],
      "help": "Select 'true' to allow student to reveal correct answer on button press."
    },
    "_canShowFeedback": {
      "type": "boolean",
      "required": false,
      "default": false,
      "title": "Feedback modal popup.",
      "inputType": {
        "type": "Boolean",
        "options": [
          true,
          false
        ]
      },
      "validators": [],
      "help": "Disable/Enable Adapt feedback notify modal for this component."
    },
    "_pinboardDesktop": {
      "type": "object",
      "required": false,
      "title": "Pin board desktop",
      "properties": {
        "src": {
          "type": "string",
          "required": true,
          "default": "",
          "inputType": "Asset:image",
          "validators": [
            "required"
          ],
          "help": "This is the image that appears behind the pins"
        },
        "alt": {
          "type": "string",
          "required": false,
          "default": "",
          "inputType": "Text",
          "validators": [],
          "help": "Alternative text for this image",
          "translatable": true
        },
        "title": {
          "type": "string",
          "required": false,
          "default": "",
          "inputType": "Text",
          "validators": [],
          "help": "Title text for this image",
          "translatable": true
        }
      }
    },
    "_pinboardMobile": {
      "type": "object",
      "required": false,
      "title": "Pin board mobile",
      "properties": {
        "src": {
          "type": "string",
          "required": true,
          "default": "",
          "inputType": "Asset:image",
          "validators": [
            "required"
          ],
          "help": "This is the image that appears behind the pins"
        },
        "alt": {
          "type": "string",
          "required": false,
          "default": "",
          "inputType": "Text",
          "validators": [],
          "help": "Alternative text for this image",
          "translatable": true
        },
        "title": {
          "type": "string",
          "required": false,
          "default": "",
          "inputType": "Text",
          "validators": [],
          "help": "Title text for this image",
          "translatable": true
        }
      }
    },
    "_items": {
      "type": "array",
      "required": true,
      "title": "Correct Zones",
      "items": {
        "type": "object",
        "required": true,
        "properties": {
          "desktop": {
            "type": "object",
            "required": true,
            "title": "Desktop Correct Zone",
            "properties": {
              "left": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Left",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Left position of correct zone (percentage)"
              },
              "top": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Top",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Top position of correct zone (percentage)"
              },
              "width": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Width",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Width of correct zone (percentage)"
              },
              "height": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Height",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Height of correct zone (percentage)"
              }
            }
          },
          "mobile": {
            "type": "object",
            "required": true,
            "title": "Mobile Correct Zone",
            "properties": {
              "left": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Left",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Left position of correct zone (percentage)"
              },
              "top": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Top",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Top position of correct zone (percentage)"
              },
              "width": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Width",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Width of correct zone (percentage)"
              },
              "height": {
                "type": "number",
                "required": true,
                "default": 0,
                "title": "Height",
                "inputType": "Number",
                "validators": [
                  "required",
                  "number"
                ],
                "help": "Height of correct zone (percentage)"
              }
            }
          }
        }
      }
    },
    "_feedback": {
      "type": "object",
      "required": false,
      "title": "Feedback",
      "properties": {
        "title": {
          "type": "string",
          "required": false,
          "default": "",
          "title": "Feedback Title",
          "inputType": "Text",
          "validators": [],
          "help": "Leave blank to have the component's title shown instead.",
          "translatable": true
        },
        "correct": {
          "type": "string",
          "required": false,
          "default": "",
          "title": "Correct",
          "inputType": "TextArea",
          "validators": [],
          "help": "Correct answer feedback for this question",
          "translatable": true
        },
        "_incorrect": {
          "type": "object",
          "required": false,
          "title": "Incorrect Feedback",
          "properties": {
            "final": {
              "type": "string",
              "required": false,
              "default": "",
              "title": "Incorrect Final",
              "inputType": "TextArea",
              "validators": [],
              "help": "Incorrect answer feedback for the final attempt",
              "translatable": true
            },
            "notFinal": {
              "type": "string",
              "required": false,
              "default": "",
              "title": "Incorrect Not Final",
              "inputType": "TextArea",
              "validators": [],
              "help": "Incorrect answer feedback for any attempt apart from the last attempt. If you leave this blank, the 'Incorrect Final' feedback will be used instead.",
              "translatable": true
            }
          }
        },
        "_partlyCorrect": {
          "type": "object",
          "required": false,
          "properties": {
            "final": {
              "type": "string",
              "required": false,
              "default": "",
              "title": "Partly Correct Final",
              "inputType": "TextArea",
              "validators": [],
              "help": "Partly correct answer feedback for the final attempt. If you leave this blank, the 'Incorrect Final' feedback will be used instead.",
              "translatable": true
            },
            "notFinal": {
              "type": "string",
              "required": false,
              "default": "",
              "title": "Partly Correct Not Final",
              "inputType": "TextArea",
              "validators": [],
              "help": "Partly correct answer feedback for any attempt apart from the last attempt. If you leave this blank, the 'Partly Correct Final' feedback will be used instead.",
              "translatable": true
            }
          }
        }
      }
    }
  }
}